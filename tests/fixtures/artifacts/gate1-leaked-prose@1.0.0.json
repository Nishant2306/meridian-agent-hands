{
  "schemaVersion": 2,
  "capabilityId": "prepare_subaccount_review",
  "name": "Prepare sub-account review",
  "description": "Open a member record in MERIDIAN Core Servicing, complete the new sub-account form, and advance to the review screen. The request is NEVER submitted: the capability's whole purpose is to leave a fully prepared, human-reviewable request in place.",
  "capabilityVersion": "1.0.0",
  "status": "approved",
  "target": {
    "product": "MERIDIAN Core Servicing",
    "surfaceKind": "legacy_web",
    "entryPoint": "http://localhost:4180/",
    "compatibility": {
      "versionRange": ">=3.2.0 <4.0.0"
    },
    "fingerprint": [
      {
        "kind": "text",
        "expected": "MERIDIAN Core v3.2"
      }
    ]
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "pattern": "^[0-9]{5}$",
      "required": true,
      "sensitivity": "pii",
      "description": "Five-digit member identifier used to locate the member record.",
      "example": "00000"
    },
    {
      "name": "accountType",
      "type": "enum",
      "values": [
        "Savings",
        "Checking"
      ],
      "required": true,
      "sensitivity": "public",
      "description": "Which kind of sub-account to prepare.",
      "example": "Savings"
    },
    {
      "name": "nickname",
      "type": "string",
      "required": false,
      "sensitivity": "pii",
      "description": "Optional display label for the sub-account. Optional on purpose: assertions that reference it must be guarded with `when.paramPresent`, or every no-nickname invocation fails.",
      "example": "EXAMPLE-NOT-REAL"
    },
    {
      "name": "initialDeposit",
      "type": "currency",
      "required": true,
      "sensitivity": "pii",
      "description": "Opening deposit amount. Compared in minor units, never as a string.",
      "example": "$1,234.56"
    }
  ],
  "outputs": [
    {
      "name": "memberName",
      "type": "string",
      "sensitivity": "pii",
      "required": true,
      "when": "success",
      "description": "The member identity displayed on the prepared request, as shown by the application.",
      "source": {
        "stateId": "review-sub-account-request",
        "target": {
          "semantic": {
            "role": "cell",
            "nameMatch": "normalized",
            "nearbyText": [
              "Member Name"
            ]
          },
          "adapterHints": {
            "web": {
              "contextPath": [
                "contentFrame"
              ]
            }
          },
          "recordedTier": "T3_EXTERNAL_LABEL_OR_NEARBY"
        },
        "parse": "text"
      }
    },
    {
      "name": "accountType",
      "type": "enum",
      "values": [
        "Savings",
        "Checking"
      ],
      "sensitivity": "public",
      "required": true,
      "when": "success",
      "description": "The account type shown on the review screen, read back from the application.",
      "source": {
        "stateId": "review-sub-account-request",
        "target": {
          "semantic": {
            "role": "cell",
            "nameMatch": "normalized",
            "nearbyText": [
              "Account Type"
            ]
          },
          "adapterHints": {
            "web": {
              "contextPath": [
                "contentFrame"
              ]
            }
          },
          "recordedTier": "T3_EXTERNAL_LABEL_OR_NEARBY"
        },
        "parse": "text"
      }
    },
    {
      "name": "reviewStatus",
      "type": "enum",
      "values": [
        "PENDING REVIEW"
      ],
      "sensitivity": "public",
      "required": true,
      "when": "success",
      "description": "The status the application reports for the prepared, unsubmitted request.",
      "source": {
        "stateId": "review-sub-account-request",
        "target": {
          "semantic": {
            "role": "cell",
            "nameMatch": "normalized",
            "nearbyText": [
              "Status"
            ]
          },
          "adapterHints": {
            "web": {
              "contextPath": [
                "contentFrame"
              ]
            }
          },
          "recordedTier": "T3_EXTERNAL_LABEL_OR_NEARBY"
        },
        "parse": "text"
      }
    }
  ],
  "recordIdentity": {
    "param": "memberId",
    "target": {
      "semantic": {
        "role": "cell",
        "nameMatch": "normalized",
        "nearbyText": [
