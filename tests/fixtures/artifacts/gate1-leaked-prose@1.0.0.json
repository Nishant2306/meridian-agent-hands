          "expected": {
            "kind": "param",
            "name": "memberId"
          },
          "description": "the control now holds the requested memberId"
        }
      ],
      "invariants": [],
      "wait": {
        "timeoutMs": 10000,
        "pollMs": 100
      },
      "risk": "SAFE_REVERSIBLE",
      "onFailure": "fail",
      "retries": {
        "max": 1,
        "backoffMs": [
          250
        ]
      },
      "notes": "Identified by accessible name \"Member ID\", recorded at T1_EXACT_ROLE_NAME."
    },
    {
      "id": "step-2-search",
