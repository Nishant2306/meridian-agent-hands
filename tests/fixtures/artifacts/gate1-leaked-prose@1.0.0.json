        {
          "id": "step-3-open.navigated-from-member-search",
          "kind": "screen_identity_changed",
          "description": "Navigated from Member Search to Member Record screen for member 10001 (Avery Lin), showing accounts list and a 'New Sub-Account' link."
        }
      ],
      "invariants": [],
