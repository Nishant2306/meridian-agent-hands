        "type": "type",
        "target": {
          "semantic": {
            "role": "textbox",
            "name": "Member ID",
            "nameMatch": "exact"
          },
          "adapterHints": {
            "web": {
              "contextPath": [
                "contentFrame"
              ],
              "stableAttribute": {
                "name": "ctl00$Main$txtMemberId"
              }
            }
          },
          "recordedTier": "T1_EXACT_ROLE_NAME"
        },
        "value": {
          "kind": "param",
          "name": "memberId"
        }
      },
      "fromState": "member-search",
      "expectedEffects": [
        {
          "id": "step-1-member-id.value-set",
          "kind": "value_matches_param",
          "target": {
            "semantic": {
              "role": "textbox",
              "name": "Member ID",
              "nameMatch": "exact"
