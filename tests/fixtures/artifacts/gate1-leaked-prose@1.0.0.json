        "timeoutMs": 10000,
        "pollMs": 100
      },
      "risk": "SAFE_REVERSIBLE",
      "onFailure": "try_recoveries_then_fail",
      "retries": {
        "max": 1,
        "backoffMs": [
          250
        ]
      },
      "notes": "Identified by accessible name \"Open\" within the row identified by {{memberId}}, recorded at T5_STRUCTURAL_ROW."
