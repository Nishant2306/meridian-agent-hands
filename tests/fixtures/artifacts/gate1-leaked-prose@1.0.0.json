          "kind": "text_present",
          "expected": {
            "kind": "literal",
            "value": "Search Results"
          },
          "description": "\"Search Results\" appeared, which was not on screen before the action"
        }
      ],
      "invariants": [],
      "wait": {
        "timeoutMs": 10000,
        "pollMs": 100
      },
      "risk": "SAFE_REVERSIBLE",
      "onFailure": "fail",
      "retries": {
        "max": 1,
        "backoffMs": [
          250
        ]
      },
      "notes": "Identified by accessible name \"Search\", recorded at T1_EXACT_ROLE_NAME."
    },
    {
      "id": "step-3-open",
      "intent": "Click 'Open' link in the search results row for member 10001 (Avery Lin) to open the member record.",
      "action": {
        "type": "click",
        "target": {
          "semantic": {
            "role": "link",
            "name": "Open",
            "nameMatch": "exact",
            "rowKey": {
              "cellText": {
                "kind": "param",
                "name": "memberId"
              }
            }
